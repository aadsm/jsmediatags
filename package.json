{
  "name": "jsmediatags",
  "version": "3.9.7",
  "description": "Media Tags Reader (ID3, MP4)",
  "author": {
    "name": "António Afonso",
    "email": "antonio.afonso@gmail.com"
  },
  "contributors": [
    {
      "name": "Jacob Seidelin"
    },
    {
      "name": "Joshua Kifer"
    },
    {
      "name": "Jesse Ditson",
      "email": "jesse.ditson@gmail.com"
    }
  ],
  "main": "build2/jsmediatags.js",
  "types": "build2/jsmediatags.d.ts",
  "browser": "dist/jsmediatags.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aadsm/jsmediatags.git"
  },
  "keywords": [
    "ID3",
    "tags",
    "mp3",
    "audio",
    "mp4"
  ],
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/aadsm/jsmediatags/issues"
  },
  "homepage": "https://github.com/aadsm/jsmediatags#readme",
  "react-native": {
    "fs": false,
    "./NodeFileReader": false
  },
  "dependencies": {
    "xhr2": "^0.1.4"
  },
  "optionalPeerDependencies": {
    "buffer": "^5.0.8",
    "react-native-fs": "^2.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.5.0",
    "@babel/preset-env": "^7.5.0",
    "@babel/preset-typescript": "^7.27.1",
    "@types/jest": "^26.0.24",
    "@types/node": "^26.1.1",
    "babel-jest": "^26.6.3",
    "browserify": "^16.3.0",
    "jest-cli": "^26.6.3",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "watchify": "^4.0.0"
  },
  "scripts": {
    "test": "jest",
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "dist-dev": "npm run build && mkdir -p dist && browserify build2/jsmediatags.js --detect-globals false -i ./build2/NodeFileReader.js -i ./build2/ReactNativeFileReader.js -o dist/jsmediatags.js -s jsmediatags",
    "dist-watch": "mkdir -p dist && watchify build2/jsmediatags.js -v --detect-globals false -i ./build2/NodeFileReader.js -i ./build2/ReactNativeFileReader.js -o dist/jsmediatags.js -s jsmediatags",
    "dist": "npm run dist-dev && terser dist/jsmediatags.js --compress --mangle -o dist/jsmediatags.min.js"
  },
  "jest": {
    "rootDir": "./src",
    "timers": "fake",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "\\.(ts|js)$": "babel-jest"
    }
  },
  "engines": {
    "node": ">=12.0.0"
  }
}
